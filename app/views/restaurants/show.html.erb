<div class="w-full flex justify-center items-center h-60 shadow-md">
  <h1 class="text-5xl font-medium"><%= @restaurant.name %></h1>
</div>

<%= link_to "<-", restaurants_path, class: "text-2xl font-bold mt-6 mx-6 self-start hover:text-stone-600"%>

<div class="mt-6 mx-6 self-start">
  <h2 class="text-2xl">About</h2>
</div>

<div class="mt-6 mx-6 self-start">
  <div class="flex items-center">
    <h2 class="text-2xl">Reviews</h2>
    <%= link_to "+", new_restaurant_review_path(@restaurant), class: "text-bold text-xl ml-4 border px-4 hover:bg-stone-950 hover:text-white"%>
  </div>
  <div class="mt-4 flex flex-col gap-4">
    <% if @restaurant.reviews.any? %>
      <% @restaurant.reviews.each do |review| %>
        <div><%= review.content %></div>
      <% end %>
    <% elsif %>
      <p>There are no reviews yet...</p>
    <% end %>
  </div>
</div>
