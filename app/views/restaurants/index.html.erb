
<div class="mt-6 flex flex-wrap justify-center gap-4 items-center w-full max-w-5xl">
  <% @restaurants.each do |restaurant| %>
    <div class="relative flex justify-center items-center size-64 max-w-md p-6 block bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
      <h2 class="text-2xl font-medium text-center"><%= restaurant.name %></h2>
      <%= link_to "", restaurant_path(restaurant), class: "cursor-pointer absolute top-0 bottom-0 w-full"%>
    </div>
  <% end %>
</div>
